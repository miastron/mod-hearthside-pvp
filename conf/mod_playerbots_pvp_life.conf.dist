###################################################################################################
# Playerbots PvP Life Module Configuration
###################################################################################################

[worldserver]

#
#   PvPLife.Enable
#       Description: Master switch to enable or disable the PvP Life module.
#       Default:     1 (Enabled)
#
PvPLife.Enable = 1

#
#   PvPLife.Debug
#       Description: Output detailed server debug logs.
#       Default:     0 (Disabled)
#
PvPLife.Debug = 0

#
#   PvPLife.Announce
#       Description: Broadcast system announcements to the entire server when activities start or end.
#                    Recommended disabled for a natural player-like atmosphere.
#       Default:     0 (Disabled)
#
PvPLife.Announce = 0

#
#   PvPLife.StartupDelaySeconds
#       Description: Delay in seconds after worldserver startup before the module begins activities.
#                    Runs once at startup; a config reload does not restart it. Capped at 3600. With
#                    UsePlayerbotConfig the playerbots login delay is used when it is longer.
#       Default:     90
#
PvPLife.StartupDelaySeconds = 90

#
#   PvPLife.TickSeconds
#       Description: Activity management tick interval in seconds (5-3600).
#       Default:     20
#
PvPLife.TickSeconds = 20

#
#   PvPLife.Events.MaxActive
#       Description: Overall ceiling for active concurrent PvP events across all categories.
#                    0 = unlimited. Tuned to 4 for conservative world bot retention.
#       Default:     4
#
PvPLife.Events.MaxActive = 4

###################################################################################################
# Bot Selection and Candidate Filtering
###################################################################################################

#
#   PvPLife.Bots.RequireBotEligibility
#       Description: Mandatory safety filter ensuring only Playerbots are ever selected.
#                    If disabled, the module refuses to start.
#       Default:     1 (Enabled)
#
PvPLife.Bots.RequireBotEligibility = 1

#
#   PvPLife.Bots.UsePlayerbotConfig
#       Description: Import account prefix and login delay settings from Playerbots configuration
#                    (checks modern Playerbots.* keys first with fallback to legacy AiPlayerbot.*).
#       Default:     1 (Enabled)
#
PvPLife.Bots.UsePlayerbotConfig = 1

#
#   PvPLife.Bots.AccountPrefix
#       Description: Account prefix for identifying bot accounts. "auto" imports
#                    Playerbots.RandomBotAccountPrefix; with UsePlayerbotConfig = 0, "auto" means no prefix
#                    (mod-playerbots' own random bots still qualify).
#       Default:     "auto"
#
PvPLife.Bots.AccountPrefix = "auto"

#
#   PvPLife.Bots.AccountMin / PvPLife.Bots.AccountMax
#       Description: Restrict candidate bot accounts by numeric ID range. 0 = unrestricted.
#       Default:     0, 0
#
PvPLife.Bots.AccountMin = 0
PvPLife.Bots.AccountMax = 0

#
#   PvPLife.Bots.AccountFilterMode
#       Description: Matching mode when both account range and prefix are specified.
#                    "legacy_any" = matches range OR prefix.
#                    "all"        = must match BOTH range and prefix.
#       Default:     "legacy_any"
#
PvPLife.Bots.AccountFilterMode = "legacy_any"

#
#   PvPLife.Bots.QueryLimit
#       Description: Maximum number of character candidates queried during candidate evaluation.
#                    Set to 0 for dynamic automatic scaling based on live online bot counts (100-1500;
#                    the offline-bot wake query then uses 100).
#                    Fixed values are clamped between 50 and 5000.
#       Default:     500
#
PvPLife.Bots.QueryLimit = 500

#
#   PvPLife.Bots.Archetypes
#       Description: mod-hearthside-chat archetypes (comma-separated enum names) PvP Life may borrow,
#                    for skirmishes, duels and defense responses alike. A bot's archetype is fixed by
#                    its GUID. Empty = every archetype. A list that names no known archetype borrows no
#                    bot at all (an error is logged on every config load). Ignored, with a warning, when
#                    mod-hearthside-chat is not in the build.
#                    Names: RAIDER_SERIOUS RAIDER_CASUAL PVP_SERIOUS PVP_CASUAL TRADER CASUAL
#                           GRUMPY_VETERAN MENTOR YOUNG_APPRENTICE SOCIALITE TROLL_MILD TROLL_AGGRESSIVE
#       Default:     "PVP_SERIOUS,PVP_CASUAL,TROLL_MILD,TROLL_AGGRESSIVE"
#
PvPLife.Bots.Archetypes = "PVP_SERIOUS,PVP_CASUAL,TROLL_MILD,TROLL_AGGRESSIVE"

#
#   PvPLife.Bots.MinOnlineRequired
#       Description: Minimum ready population required across both sides to start an activity.
#                    Duel zones need only one pair (2 bots) regardless.
#       Default:     3
#
PvPLife.Bots.MinOnlineRequired = 3

#
#   PvPLife.Bots.GlobalMinLevel
#       Description: Lowest level allowed for world skirmishes. Prevents lowbies from being dragged to war.
#       Default:     20
#
PvPLife.Bots.GlobalMinLevel = 20

#
#   PvPLife.Bots.SkipGrouped
#       Description: Do not borrow bots participating in party, raid, or dungeon groups with real players.
#       Default:     1 (Enabled)
#
PvPLife.Bots.SkipGrouped = 1

#
#   PvPLife.Bots.RespectPlayerbotActivity
#       Description: Respect Playerbots internal activity filters.
#       Default:     0 (Disabled)
#
PvPLife.Bots.RespectPlayerbotActivity = 0

#
#   PvPLife.Bots.AllowPartialTeams
#       Description: Start activities with fewer bots than target if at least MinimumPerSide are ready.
#       Default:     1 (Enabled)
#
PvPLife.Bots.AllowPartialTeams = 1

#
#   PvPLife.Bots.MinimumPerSide
#       Description: Minimum bots required per side for partial teams.
#       Default:     1
#
PvPLife.Bots.MinimumPerSide = 1

#
#   PvPLife.Bots.MaxPerSide
#       Description: Maximum ceiling of bots assigned per faction per event.
#       Default:     100
#
PvPLife.Bots.MaxPerSide = 100

#
#   PvPLife.Bots.ReturnWhenReleased
#       Description: Return participating bots to their original locations when the activity ends.
#                    A bot a real player can see walks off instead and carries on there as an
#                    ordinary bot. Up to Population.MaxChangesPerTick bots are released a second; one
#                    still waiting after 120 seconds (in combat, mid-teleport) is released at once,
#                    and is still restored and sent home.
#                    Same key as CityLife.Bots.ReturnWhenReleased. The old name,
#                    PvPLife.Bots.ReturnAfterActivity, is still read when this one is not set.
#       Default:     1 (Enabled)
#
PvPLife.Bots.ReturnWhenReleased = 1

###################################################################################################
# Movement and Engagement
###################################################################################################

#
#   PvPLife.Movement.TeleportOnArrival
#       Description: Teleport bots directly to the staging rally point upon arrival.
#       Default:     1 (Enabled)
#
PvPLife.Movement.TeleportOnArrival = 1

#
#   PvPLife.Movement.DropOffArrival
#       Description: Bots never pop in at an activity point. A bot on the same map within 140 yards walks
#                    (or rides) there along the navmesh; any other bot is first dropped off 70-120 yards out,
#                    at a spot no real player is near or has line of sight to, with a plain walkable path in
#                    (no partial path, no ledge drops, no long detour) and no hostile creatures beside it, then
#                    mounts (a flying mount where the zone allows one) and rides in. Covers arrivals, the
#                    HardTeleportToTarget move and the duel leash. Falls back to the old teleport only when no
#                    such spot exists. Overrides TeleportOnArrival.
#       Default:     1 (Enabled)
#
PvPLife.Movement.DropOffArrival = 1

#
#   PvPLife.Movement.UseMovePoint
#       Description: Advance bots toward target combat point using MotionMaster MovePoint.
#       Default:     1 (Enabled)
#
PvPLife.Movement.UseMovePoint = 1

#
#   PvPLife.Movement.HardTeleportToTarget
#       Description: Hard teleport attackers directly to target point instead of walking.
#       Default:     0 (Disabled)
#
PvPLife.Movement.HardTeleportToTarget = 0

#
#   PvPLife.Movement.PositionJitter
#       Description: Random offset range (in yards) added to positions to prevent stacking.
#       Default:     10
#
PvPLife.Movement.PositionJitter = 10

#
#   PvPLife.Movement.ArrivalStaggerMinSeconds / ArrivalStaggerMaxSeconds
#       Description: Delay range in seconds for staggered bot arrivals.
#       Default:     2, 12
#
PvPLife.Movement.ArrivalStaggerMinSeconds = 2
PvPLife.Movement.ArrivalStaggerMaxSeconds = 12

#
#   PvPLife.Movement.MoveAfterArrivalMinSeconds / MoveAfterArrivalMaxSeconds
#       Description: Delay range in seconds before advancing toward combat target.
#       Default:     6, 20
#
PvPLife.Movement.MoveAfterArrivalMinSeconds = 6
PvPLife.Movement.MoveAfterArrivalMaxSeconds = 20

#
#   PvPLife.Strategies.Enable
#       Description: Enable dynamic application of native Playerbots PvP combat strategies.
#       Default:     1 (Enabled)
#
PvPLife.Strategies.Enable = 1

#
#   PvPLife.Combat.ForcePvpFlag
#       Description: Force PvP flag on participating bots during events.
#       Default:     1 (Enabled)
#
PvPLife.Combat.ForcePvpFlag = 1

#
#   PvPLife.Combat.ForceAttackOnEngage
#       Description: Automatically initiate attack against opposing bots upon reaching combat area.
#       Default:     1 (Enabled)
#
PvPLife.Combat.ForceAttackOnEngage = 1

#
#   PvPLife.Combat.EngageAfterMoveSeconds
#       Description: Seconds after advance movement before initiating attack.
#       Default:     4
#
PvPLife.Combat.EngageAfterMoveSeconds = 4

#
#   PvPLife.Combat.EngageRetrySeconds
#       Description: Retry interval in seconds if target engagement fails initially.
#       Default:     5
#
PvPLife.Combat.EngageRetrySeconds = 5

#
#   PvPLife.Combat.EngageMaxRetries
#       Description: Maximum engagement retry attempts before giving up.
#       Default:     12
#
PvPLife.Combat.EngageMaxRetries = 12

#
#   PvPLife.Strategies.Combat / NonCombat / DuelNonCombat
#       Description: Strategy expressions assigned to bots during combat, roaming, and duels.
#                    "-new rpg,-rpg,-travel" are always added to the non-combat set, whatever is
#                    configured here: those strategies walk bots off to the nearest innkeeper, flight
#                    master or quest, which the event leash then pulls back, over and over.
#
PvPLife.Strategies.Combat = "+pvp,+boost,+dps debuff,-passive,-stay"
PvPLife.Strategies.NonCombat = "+pvp,+boost,-passive,-stay,-new rpg"
PvPLife.Strategies.DuelNonCombat = "+duel,+pvp,+boost,+stay,-follow,-passive,-grind,-new rpg"

###################################################################################################
# Persistent World PvP
###################################################################################################

#
#   PvPLife.World.AlwaysActive
#       Description: Ensure outdoor PvP is actively running in at least one zone whenever possible.
#       Default:     1 (Enabled)
#
PvPLife.World.AlwaysActive = 1

#
#   PvPLife.World.MinActiveHotspots / MaxActiveHotspots
#       Description: Number of normal outdoor PvP hotspots to keep active concurrently.
#       Default:     1, 3
#
PvPLife.World.MinActiveHotspots = 1
PvPLife.World.MaxActiveHotspots = 3

#
#   PvPLife.World.RandomStartChance
#       Description: Chance (percentage) per management tick to start an additional activity.
#       Default:     35
#
PvPLife.World.RandomStartChance = 35

###################################################################################################
# Duel Zones
###################################################################################################

#
#   PvPLife.Duel.Enable
#       Description: Enable persistent capital gate and wilderness duel zones.
#       Default:     1 (Enabled)
#
PvPLife.Duel.Enable = 1

#
#   PvPLife.Duel.AlwaysActive
#       Description: Keep bots persistently stationed in active duel zones.
#       Default:     1 (Enabled)
#
PvPLife.Duel.AlwaysActive = 1

#
#   PvPLife.Duel.SpellId
#       Description: Classic duel challenge spell ID (7266).
#       Default:     7266
#
PvPLife.Duel.SpellId = 7266

#
#   PvPLife.Duel.PairLimit
#       Description: Maximum number of bot-vs-bot duel pairs scheduled concurrently (1-40).
#       Default:     12
#
PvPLife.Duel.PairLimit = 12

#
#   PvPLife.Duel.PairDelayMinSeconds / PairDelayMaxSeconds
#       Description: Random delay in seconds before an idle pair of duel bots is matched for the next duel.
#       Default:     5, 18
#
PvPLife.Duel.PairDelayMinSeconds = 5
PvPLife.Duel.PairDelayMaxSeconds = 18

#
#   PvPLife.Duel.LeashRadius
#       Description: Distance in yards an idle duel bot may stray from its own staging point before it is
#                    called back (walks back with DropOffArrival, else teleported) (10-1000).
#       Default:     40
#
PvPLife.Duel.LeashRadius = 40

#
#   PvPLife.Duel.GuardIntervalMs
#       Description: How often, in milliseconds, idle duel bots are checked against the leash (250-5000).
#       Default:     1000
#
PvPLife.Duel.GuardIntervalMs = 1000

#
#   PvPLife.Duel.Matchup.DpsVsDps / DpsVsTank / TankVsTank / DpsVsHealer / HealerVsHealer / TankVsHealer
#       Description: Percent chance (0-100) that two bots of these roles may be paired for a duel, rolled
#                    each time the pair comes up (pairing runs every PvPLife.TickSeconds, so a rare matchup
#                    still happens now and then). Healer duels drag on with little damage until someone
#                    gives up, so a healer is rarely paired. Roles come from mod-playerbots' spec checks
#                    (a feral druid in bear form counts as a tank).
#       Default:     100, 70, 25, 10, 5, 0
#
PvPLife.Duel.Matchup.DpsVsDps = 100
PvPLife.Duel.Matchup.DpsVsTank = 70
PvPLife.Duel.Matchup.TankVsTank = 25
PvPLife.Duel.Matchup.DpsVsHealer = 10
PvPLife.Duel.Matchup.HealerVsHealer = 5
PvPLife.Duel.Matchup.TankVsHealer = 0

#
#   PvPLife.Duel.IdleFidget.Enable / MinSeconds / MaxSeconds
#       Description: Between bouts an idle duelist now and then wanders a few yards within 6 yards of
#                    its staging spot (mostly ahead or to one side, mostly at a run, and often a look
#                    round on arriving), sidesteps a yard or two, or turns to watch a duel nearby, its
#                    partner, a real player close by, or glances off to one side, so the pairs do not
#                    stand frozen face to face. Each bot acts
#                    once every MinSeconds to MaxSeconds, only while mod-playerbots has it active (a real
#                    player nearby).
#       Default:     1 (Enabled), 6, 20
#
PvPLife.Duel.IdleFidget.Enable = 1
PvPLife.Duel.IdleFidget.MinSeconds = 6
PvPLife.Duel.IdleFidget.MaxSeconds = 20

#
#   PvPLife.Duel.WindDown.Enable / IntervalMinSeconds / IntervalMaxSeconds / LingerMinSeconds /
#   LingerMaxSeconds / MaxSeconds
#       Description: When a duel ground's time is up and a real player is near (mod-playerbots'
#                    BotActiveAlone rules), the bots leave one at a time instead of all at once: every
#                    IntervalMin-Max seconds an idle one (never one mid-duel) walks off and mod-playerbots
#                    takes it back, preferring one whose partner is still there. The partner it leaves
#                    lingers LingerMin-Max seconds (idling, watching, healing, maybe dueling someone else
#                    left over) and then goes too. A bot mod-playerbots takes into a battleground or
#                    dungeon mid-event counts as leaving, and its partner lingers the same way. Whatever
#                    is left after MaxSeconds goes at once; with nobody near, everyone goes at once.
#       Default:     1 (Enabled), 30, 150, 60, 300, 900
#
PvPLife.Duel.WindDown.Enable = 1
PvPLife.Duel.WindDown.IntervalMinSeconds = 30
PvPLife.Duel.WindDown.IntervalMaxSeconds = 150
PvPLife.Duel.WindDown.LingerMinSeconds = 60
PvPLife.Duel.WindDown.LingerMaxSeconds = 300
PvPLife.Duel.WindDown.MaxSeconds = 900

#
#   PvPLife.Duel.QuietMinSeconds / QuietMaxSeconds
#       Description: Once a duel ground has emptied, it stays quiet a random QuietMin-Max seconds before
#                    PvPLife.Duel.AlwaysActive starts it again: sometimes right away, sometimes a while.
#                    Not applied after a config reload, a GM stop or a shutdown.
#       Default:     30, 1200
#
PvPLife.Duel.QuietMinSeconds = 30
PvPLife.Duel.QuietMaxSeconds = 1200

#
#   PvPLife.Duel.Bored.Chance / AfterSeconds / MultiplierMin / MultiplierMax
#       Description: A duelist that has gone AfterSeconds without a duel, or that was just left behind
#                    by its partner, rolls once at Chance% to turn restless: its antics come
#                    MultiplierMin-Max times as often (PvPLife.Antics.ChancePerMinute, capped at 100) with
#                    that fraction of PvPLife.Antics.CooldownSeconds between them. Its next duel calms it.
#       Default:     35, 240, 2, 4
#
PvPLife.Duel.Bored.Chance = 35
PvPLife.Duel.Bored.AfterSeconds = 240
PvPLife.Duel.Bored.MultiplierMin = 2
PvPLife.Duel.Bored.MultiplierMax = 4

#
#   PvPLife.DuelMedics.Enable / MedicPercent / Chance / MaxPerDuel / Radius
#       Description: An idle healer duelist (Holy/Discipline priest, Holy paladin, Restoration shaman or
#                    druid) now and then heals the duelists of a duel that just ended in front of it, real
#                    players' duels included. Only MedicPercent of healers ever do it (fixed per bot, so it
#                    is the same few), only within Radius yards with the duel in front of them, and only on
#                    Chance of the duels. MaxPerDuel medics at most per duel: the first heals the loser,
#                    a second the winner. City Life's spectators do the same (CityLife.DuelMedics.*).
#       Default:     1 (Enabled), 30, 50, 1, 30
#
PvPLife.DuelMedics.Enable = 1
PvPLife.DuelMedics.MedicPercent = 30
PvPLife.DuelMedics.Chance = 50
PvPLife.DuelMedics.MaxPerDuel = 1
PvPLife.DuelMedics.Radius = 30

#
#   PvPLife.Footwork.Duels / PvPLife.Footwork.WorldPvP
#       Description: Make leased bots move like players while fighting a player, by class and spec
#                    (src/PvPLifeFootwork.h, from docs/duel-tactics-3.3.5a.md). Casters stand and cast and
#                    only reposition through a window (Frost Nova, Fear, Psychic Scream, Wing Clip...) or an
#                    escape (Blink, Disengage); hunters keep out of the dead zone; melee use gap-closers
#                    (Charge, Intercept, Shadowstep, Death Grip, Feral Charge), rogues and cats get behind,
#                    and melee circle, juke and stutter-step. Never during a cast or a stun/root/fear. In a duel no
#                    move leaves 38 yards of the duel flag (out of bounds is 50), and a bot near the edge
#                    steps back in first. Duels = duel zones; WorldPvP = skirmishes and faction campaigns.
#       Default:     1, 1 (Enabled)
#
PvPLife.Footwork.Duels = 1
PvPLife.Footwork.WorldPvP = 1

#
#   PvPLife.Footwork.Battlegrounds
#       Description: The same footwork for every bot (leased or not) fighting a player in a running
#                    battleground, never arenas. Objectives win: never a flag carrier (WSG, EotS), never a
#                    bot mod-playerbots is walking somewhere away from the fight, never mid-cast (which
#                    covers capturing a flag or base), and each move stays within 12 yards of where the
#                    bot stood. Off by default while it is being tested.
#       Default:     0 (Disabled)
#
PvPLife.Footwork.Battlegrounds = 0

#
#   PvPLife.Footwork.DuelPrep
#       Description: Leased duelists use the 3-second countdown the way players do instead of standing
#                    still: a ranged spec backs off to its range (hunters 25 yards, casters 20, priests 16)
#                    and a warrior out to Charge range, turning to run when it is far and backpedalling when
#                    it is close; and each casts up to two self-spells it is not already wearing (Stealth,
#                    Prowl, Power Word: Shield, Ice Barrier, Demonic Circle, a shield or a HoT...). Two bots
#                    that both back off share the ground unevenly and react at different moments, each
#                    at its own angle; one already close to its range often just waits. Works without
#                    PvPLife.Footwork.Duels. Traced as
#                    DUELPREP lines with PvPLife.Footwork.Trace.
#       Default:     1 (Enabled)
#
PvPLife.Footwork.DuelPrep = 1

#
#   PvPLife.Footwork.IntervalMinMs / IntervalMaxMs
#       Description: Random delay between one bot's footwork decisions, in milliseconds.
#       Default:     1000, 2500
#
PvPLife.Footwork.IntervalMinMs = 1000
PvPLife.Footwork.IntervalMaxMs = 2500

#
#   PvPLife.Footwork.Melee.IntervalMinMs / IntervalMaxMs
#       Description: The same delay for melee specs, which move more than casters: a player in melee
#                    range keeps circling, juking through to the far side and stepping in and out.
#       Default:     600, 1400
#
PvPLife.Footwork.Melee.IntervalMinMs = 600
PvPLife.Footwork.Melee.IntervalMaxMs = 1400

#
#   PvPLife.Footwork.Melee.HoldChance
#       Description: Percent of a melee bot's decisions in reach of its target where it holds its ground
#                    (0-100); otherwise it circles, juke-steps through to the target's far side, or steps
#                    out and back, each still within melee range.
#       Default:     10
#
PvPLife.Footwork.Melee.HoldChance = 10

#
#   PvPLife.Footwork.Hunter.IntervalMinMs / IntervalMaxMs
#       Description: The same delay for hunters: between casters and melee. Auto Shot pauses while
#                    moving, but a hunter's instants do not, so a player keeps shuffling between shots.
#       Default:     800, 1800
#
PvPLife.Footwork.Hunter.IntervalMinMs = 800
PvPLife.Footwork.Hunter.IntervalMaxMs = 1800

#
#   PvPLife.Footwork.Hunter.HoldChance
#       Description: Percent of a hunter's decisions in its range band where it stands and shoots
#                    (0-100); otherwise it strafes, shifts a few yards, or (target near or held) backs
#                    off toward the far edge of the band. The dead-zone rules are unchanged.
#       Default:     35
#
PvPLife.Footwork.Hunter.HoldChance = 35

#
#   PvPLife.Footwork.JumpChance
#       Description: Percent of footwork moves made as a jump (0-100).
#       Default:     35
#
PvPLife.Footwork.JumpChance = 35

#
#   PvPLife.Footwork.Trace
#       Description: Write every footwork decision (the move, the spell cast, or why the bot held still) to
#                    the audit log as FOOTWORK lines (and countdown prep as DUELPREP). For tuning; noisy.
#       Default:     0 (Disabled)
#
PvPLife.Footwork.Trace = 0

#
#   PvPLife.Antics.Enable
#       Description: Between bouts an idle bot on a duel ground now and then plays out an antic: Dance
#                    (/dance), HopBackForth (hops forward and back, backpedalling or turning round
#                    between hops), HopSideToSide (strafe hops) or BunnyHop (hop after hop on a
#                    wandering line, or round a loose circle, a figure 8 or a zigzag). A bot does not
#                    start the antic another bot within 20 yards is already doing. It stops at once
#                    when the bot is picked for a duel, fights, is released or mod-playerbots pauses it.
#                    The code is mod-hearthside-life's src/LifeMotion.h, shared with City Life's
#                    CityLife.Antics.*. Test one with .pvplife debug antic <name> <antic>.
#       Default:     1 (Enabled)
#
PvPLife.Antics.Enable = 1

#
#   PvPLife.Antics.ChancePerMinute
#       Description: Percent chance (0-100) that an idle duel-ground bot starts an antic in any given minute.
#                    Bots are idle for only about a minute between duels (and are not paired again
#                    until an antic finishes), so this is higher than City Life's.
#       Default:     30
#
PvPLife.Antics.ChancePerMinute = 30

#
#   PvPLife.Antics.CooldownSeconds
#       Description: Seconds a bot waits after one antic before it may start another.
#       Default:     120
#
PvPLife.Antics.CooldownSeconds = 120

#
#   PvPLife.Antics.Radius
#       Description: How far (yards, 3-20) a hopping antic strays from where it started. Every step also
#                    stays within 10 yards of the bot's staging spot, clear of the neighbouring duels.
#       Default:     6
#
PvPLife.Antics.Radius = 6

#
#   PvPLife.Antics.HopDismount.Chance
#       Description: Percent of bots riding in to a duel ground that hop and dismount in mid-air instead
#                    of stopping first (0 = never).
#       Default:     35
#
PvPLife.Antics.HopDismount.Chance = 35

#
#   PvPLife.Antics.<Antic>.Weight / MinSeconds / MaxSeconds
#       Description: Per antic: relative odds of being picked (0 = never, at most 1000) and how long it
#                    lasts, in seconds.
#       Default:     Weight 20 each; Dance 30-60, HopBackForth 5-10, HopSideToSide 5-10,
#                    BunnyHop 15-30
#
PvPLife.Antics.Dance.Weight = 20
PvPLife.Antics.Dance.MinSeconds = 30
PvPLife.Antics.Dance.MaxSeconds = 60
PvPLife.Antics.HopBackForth.Weight = 20
PvPLife.Antics.HopBackForth.MinSeconds = 5
PvPLife.Antics.HopBackForth.MaxSeconds = 10
PvPLife.Antics.HopSideToSide.Weight = 20
PvPLife.Antics.HopSideToSide.MinSeconds = 5
PvPLife.Antics.HopSideToSide.MaxSeconds = 10
PvPLife.Antics.BunnyHop.Weight = 20
PvPLife.Antics.BunnyHop.MinSeconds = 15
PvPLife.Antics.BunnyHop.MaxSeconds = 30

#
#   PvPLife.Duel.ChallengeRealPlayers
#       Description: Allow bots in duel zones to challenge nearby real players of their own faction.
#                    Never GMs, and never a player who is dead, mounted, on a vehicle or taxi, AFK, DND,
#                    trading, in combat or already in a duel.
#       Default:     1 (Enabled)
#
#   PvPLife.Duel.PlayerChallengeChance     - percent chance per bot and tick to challenge (0-100)
#   PvPLife.Duel.PlayerScanRadius          - yards around the bot to look for a player (max 1000)
#   PvPLife.Duel.MaxLevelDifference        - max level gap between bot and player
#   PvPLife.Duel.PlayerChallengeCooldownSeconds - per player; shared with City Life's challenges
#   PvPLife.Duel.BotChallengeCooldownSeconds    - per bot, after it challenged a player
#   PvPLife.Duel.BotVsBotCooldownSeconds   - per bot, after a bot-vs-bot duel
#   PvPLife.Duel.BotVsBotMaxLevelDifference - max level gap within a bot pair (max 80); pairs aim for a random 0-2
#       Cooldowns here and elsewhere in this file are capped at 604800 (one week).
#
PvPLife.Duel.ChallengeRealPlayers = 1
PvPLife.Duel.PlayerChallengeChance = 25
PvPLife.Duel.PlayerScanRadius = 55
PvPLife.Duel.MaxLevelDifference = 5
PvPLife.Duel.PlayerChallengeCooldownSeconds = 900
PvPLife.Duel.BotChallengeCooldownSeconds = 180
PvPLife.Duel.BotVsBotCooldownSeconds = 45
PvPLife.Duel.BotVsBotMaxLevelDifference = 2

###################################################################################################
# For the Horde / For the Alliance Campaigns
###################################################################################################

PvPLife.ForTheHorde.Enable = 1
PvPLife.ForTheAlliance.Enable = 1
PvPLife.FactionCampaign.ChancePerTick = 12
PvPLife.FactionCampaign.GlobalCooldownSeconds = 3600

###################################################################################################
# Reactive Raid Defense
###################################################################################################

#
#   PvPLife.ReactiveRaidResponse.Enable
#       Description: Deploy reactive bot defenders when a real-player-led outdoor raid of the opposite
#                    faction is detected outside its own faction's territory (and not in Wintergrasp
#                    while the battle is on).
#       Default:     1 (Enabled)
#
PvPLife.ReactiveRaidResponse.Enable = 1
PvPLife.ReactiveRaidResponse.AllianceEnable = 1
PvPLife.ReactiveRaidResponse.HordeEnable = 1

#
#   PvPLife.ReactiveRaidResponse.MinGroupSize
#       Description: Minimum number of raid group members to trigger a reactive response.
#       Default:     20
#
PvPLife.ReactiveRaidResponse.MinGroupSize = 20

#
#   PvPLife.ReactiveRaidResponse.MaxResponders
#       Description: Maximum number of bot defenders recruited for a reactive response.
#                    Tuned to 25 so defenders mount a massive counter-strike without exhausting high-level bots.
#       Default:     25
#
PvPLife.ReactiveRaidResponse.MaxResponders = 25

#
#   PvPLife.ReactiveRaidResponse.LevelMode
#       Description: Level matching mode for defenders.
#                    "raid"  = dynamically matches invading group's level profile.
#                    "fixed" = recruits defenders at PvPLife.ReactiveRaidResponse.FixedLevel.
#       Default:     "raid"
#
PvPLife.ReactiveRaidResponse.LevelMode = "raid"
PvPLife.ReactiveRaidResponse.FixedLevel = 60
PvPLife.ReactiveRaidResponse.MaxLevelDifference = 5

#
#   PvPLife.ReactiveRaidResponse.LoginOfflineBots
#       Description: Optionally wake existing offline random bots if online capacity is insufficient.
#       Default:     0 (Disabled)
#
PvPLife.ReactiveRaidResponse.LoginOfflineBots = 0
PvPLife.ReactiveRaidResponse.LoginDelaySeconds = 20
PvPLife.ReactiveRaidResponse.LoginTimeoutSeconds = 60
PvPLife.ReactiveRaidResponse.MaxConcurrentLogins = 4

# The cooldown starts when a response actually deploys; one that never starts does not use it up.
PvPLife.ReactiveRaidResponse.CooldownSeconds = 1800
PvPLife.ReactiveRaidResponse.DurationMinutes = 20

# Formation staging geometry: defenders stand RallyDistance yards from the raid leader in rows of
# FormationColumns, LaneSpacing yards apart, then advance on the leader's position.
PvPLife.ReactiveRaidResponse.RallyDistance = 120.0
PvPLife.ReactiveRaidResponse.LaneSpacing = 4.0
PvPLife.ReactiveRaidResponse.FormationColumns = 9

###################################################################################################
# Conservative Balanced Population Budget
###################################################################################################

#
#   PvPLife.Population.Enable
#       Description: Enable shared borrowing budget calculations.
#       Default:     1 (Enabled)
#
PvPLife.Population.Enable = 1

#
#   PvPLife.Population.BudgetMode
#       Description: Budget calculation mode: "percentage" (BorrowPercent of the live bots) or "count"
#                    (FixedCount; "fixed" means the same). Any other value is read as "percentage".
#       Default:     "percentage"
#
PvPLife.Population.BudgetMode = "percentage"
PvPLife.Population.FixedCount = 100
PvPLife.Population.BorrowPercent = 10

# Global ceiling across all PvP activities combined. The budget is the smaller of BorrowPercent of the
# live bots (or FixedCount) and MaxTotal, so above MaxTotal * 100 / BorrowPercent live bots only
# MaxTotal matters. Set to 0 for no ceiling (budget scales purely with live world bots * BorrowPercent).
# Tuned conservatively to 120 max total bots across all activities on a 1,000-bot server.
#
# Events are sized from their zone rows whether or not a real player is near: an event nobody is near
# is prepared in full and stays dormant until mod-playerbots wakes its bots (Playerbots.BotActiveAlone
# and its ForceWhenInZone / ForceWhenInRadius / ForceWhenInMap rules). Those same rules decide
# priority: a spot near a real player that cannot start for lack of budget holds off the spots nobody
# is near until it has its bots. (DemandMode, BaselinePercent and BurstGraceSeconds are gone.)
PvPLife.Population.MaxTotal = 120

PvPLife.Population.MaxChangesPerTick = 3

# Proportional Zone & Skirmish Scaling:
# When enabled (1), zone min/max bot populations dynamically scale up or down based on
# live active world bots relative to 1,000-bot baseline (2v2 skirmishes at low population,
# expanding into full-scale 10v10+ battles during high server population).
# Default: 1 (Enabled)
PvPLife.Population.ProportionalZoneScaling = 1

###################################################################################################
# Battleground Start
###################################################################################################

#
#   PvPLife.Battleground.MountStagger.Enable / Seconds
#       Description: mod-playerbots mounts every bot waiting at a battleground's gate the moment the
#                    start countdown passes 30 seconds, all on the same tick. With this on, each bot
#                    is held off until its own moment, spread over the Seconds that follow (26: from
#                    0:30 down to 0:04). The moment is fixed per bot and match. Only bots run by their
#                    own AI are held, never a person, a SelfBot or a player's alt bot. Works whether
#                    or not PvPLife.Enable is on; 0 Seconds is the same as off.
#       Default:     1 (Enabled), 26 (max 29)
#
PvPLife.Battleground.MountStagger.Enable = 1
PvPLife.Battleground.MountStagger.Seconds = 26

###################################################################################################
# Asynchronous Audit Logger
###################################################################################################

#
#   PvPLife.Audit.Enable
#       Description: Enable bounded asynchronous audit logging to file on a dedicated thread.
#       Default:     1 (Enabled)
#
PvPLife.Audit.Enable = 1

#
#   PvPLife.Audit.FilePath
#       Description: File path for audit log records.
#       Default:     "Logs/pvplife_audit.log"
#
PvPLife.Audit.FilePath = "Logs/pvplife_audit.log"

###################################################################################################
# Per-Zone Overrides (optional)
###################################################################################################

# Each hotspot's enabled flag and population come from its pvp_life_zone row, which the GM zone
# commands (.pvplife zone enable / counts) edit. A key below, when set, overrides that row, GM edits
# included, until it is removed again:
#
#   PvPLife.Zone.<name>.Enable        - 0 or 1
#   PvPLife.Zone.<name>.MinPopulation - total bots, both sides together
#   PvPLife.Zone.<name>.MaxPopulation
#
# <name> is the zone name exactly as .pvplife zone list shows it. Population values are clamped to
# 2 x Bots.MinimumPerSide .. 2 x Bots.MaxPerSide. For example:
#
#PvPLife.Zone.Orgrimmar_Zeppelin.Enable = 0
#PvPLife.Zone.STV_Nesingwary.MinPopulation = 4
#PvPLife.Zone.STV_Nesingwary.MaxPopulation = 10
